<?xml version="1.0" encoding="utf-8"?>
<!-- BeamCtrl is left out of Android's own backups completely: nothing goes into a cloud backup and
     nothing moves in a phone-to-phone transfer (allowBackup and fullBackupContent are off as well).
     To move remotes to another phone, use "Back up to a file" and "Restore from a file" on the You page.
     Every storage domain is excluded, including device-protected storage. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
