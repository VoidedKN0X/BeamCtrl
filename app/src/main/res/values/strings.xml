    <!-- Privacy and security: the shared Ctrl series app lock -->
    <string name="group_privacy">Privacy and security</string>
    <string name="app_lock">App lock</string>
    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening BeamCtrl, so nobody else can use or change your remotes</string>
    <string name="app_lock_footer">BeamCtrl works fully offline: it has no internet permission, analytics or tracking. The app lock only keeps BeamCtrl closed; there are no passwords to protect.</string>
