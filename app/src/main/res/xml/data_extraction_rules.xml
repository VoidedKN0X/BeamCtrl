<?xml version="1.0" encoding="utf-8"?>
<!-- Saved remotes and settings go into Android's cloud backup only when it is end-to-end
     encrypted (the phone has a screen lock), and move over in a direct phone-to-phone transfer.
     Temporary and unreadable copies of the remotes file are never included. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="remotes.json.tmp" />
        <exclude domain="file" path="remotes.json.unreadable" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="remotes.json.tmp" />
        <exclude domain="file" path="remotes.json.unreadable" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
