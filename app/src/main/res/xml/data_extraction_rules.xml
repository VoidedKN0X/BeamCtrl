<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes into a cloud backup (allowBackup is off as well). Saved remotes and settings still
     move to a new phone in a direct phone-to-phone transfer, without the app lock: its keys are tied to
     this phone's secure hardware, so the lock is set up again on the new phone. Temporary and unreadable
     copies of the remotes file are never included. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="remotes.json.tmp" />
        <exclude domain="file" path="remotes.json.unreadable" />
        <exclude domain="sharedpref" path="app_lock_vault.xml" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
