    <!-- Backup (on the You page) -->
    <string name="backup_group">Backup</string>
    <string name="backup_footer">To move BeamCtrl to another phone, back up here, copy the file to the new phone, then tap Restore from a file in BeamCtrl there. The file holds every remote and setting, but never the app lock PIN or fingerprint: set the app lock up again on the new phone. The file isn\'t encrypted, so keep it somewhere private. BeamCtrl isn\'t in Android\'s cloud backup or phone-to-phone transfer, so this file is the only copy of your remotes off this phone.</string>
    <string name="backup_to_file">Back up to a file</string>
    <plurals name="backup_to_file_subtitle">
        <item quantity="one">Your remote and all settings, saved where you choose</item>
        <item quantity="other">All %d remotes and your settings, saved where you choose</item>
    </plurals>
